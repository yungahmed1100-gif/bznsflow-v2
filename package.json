{
  "name": "bznsflow-main",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:api": "vercel dev",
    "prebuild": "node scripts/gen-kb.mjs --check && npm run gen:sitemap",
    "build": "react-router build && node scripts/copy-static-build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node tests/api-chat.test.mjs && node tests/cookies.test.mjs && node tests/auth.test.mjs && node tests/oauth.test.mjs && node tests/lead.test.mjs && node tests/contracts.test.mjs && node --test tests/green-config.test.mjs tests/green-cutover.test.mjs tests/green-whatsapp.test.mjs && npm run test:layla && npm run test:access",
    "test:e2e": "node tests/e2e-chat.mjs",
    "test:stack": "./scripts/chat-test-stack.sh",
    "gen:kb": "node scripts/gen-kb.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "test:auth-browser": "node tests/auth-browser.mjs",
    "test:layla": "node --test tests/layla-meta.test.mjs tests/layla-meta-db.test.mjs tests/layla-setup.test.mjs tests/layla-open.test.mjs tests/layla-customer.test.mjs tests/layla-scheduler.test.mjs tests/product-api.test.mjs tests/product-setup.test.mjs tests/knowledge-import.test.mjs tests/product-handoffs.test.mjs",
    "test:layla-browser": "node tests/layla-meta-browser.mjs",
    "test:access": "node --test tests/blue-auth.test.mjs tests/hasib-plans.test.mjs tests/blue-dashboard.test.mjs",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen",
    "green:readiness": "node scripts/check-green-readiness.mjs",
    "green:export": "node ops/migration/export-green-supabase.mjs",
    "green:import": "node ops/migration/import-green-supabase.mjs",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit",
    "test:release": "node scripts/verify-release.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "preview:product": "node scripts/product-preview.mjs"
  },
  "dependencies": {
    "@vercel/functions": "3.9.7",
    "@vercel/speed-insights": "^2.0.0",
    "convex": "^1.45.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4",
    "tesseract.js": "^7.0.0",
    "react-router": "7.18.4",
    "@react-router/node": "7.18.4",
    "isbot": "^5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.61.0",
    "typescript": "^6.0.0",
    "vite": "^6.4.3",
    "@react-router/dev": "7.18.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
