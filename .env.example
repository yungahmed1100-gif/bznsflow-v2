# ==============================================================================
# BznsFlow — environment template.  Copy to .env and fill in:  cp .env.example .env
# This file is COMMITTED and must never contain real values.
#
# ⚠️  VITE_* vars are BAKED INTO THE PUBLIC BROWSER BUNDLE. Never give a secret
#     the VITE_ prefix — only public URLs belong there.
# ==============================================================================


# ─── DEPLOY / HOSTING ─────────────────────────────────────────────────────────
# https://vercel.com/account/tokens — needs FULL team scope, else deploys fail
# with "Could not retrieve Project Settings". Tokens expire; note the date.
VERCEL_TOKEN=


# ─── AI / GENERATION ──────────────────────────────────────────────────────────
GEMINI_API_KEY=          # https://aistudio.google.com/apikey — agent avatar script
GROQ_API_KEY=            # https://console.groq.com — powers Layla via /api/chat


# ─── LAYLA CHAT BACKEND (Vercel /api/chat → Groq → Supabase) ──────────────────
# Runbook: web-chatbot/SETUP.md · these are also set in Vercel (Prod + Preview).
#
# Leave VITE_CHAT_ENDPOINT UNSET — src/lib/chat.js defaults to same-origin
# '/api/chat'. Setting it is the rollback lever only.
# VITE_CHAT_ENDPOINT=

SUPABASE_URL=            # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=       # publishable; not used by /api/chat
SUPABASE_SERVICE_ROLE_KEY=   # bypasses RLS — server-side only, never VITE_
SUPABASE_REGION=         # e.g. ap-southeast-1 — drives `regions` in vercel.json

CHAT_ALLOWED_ORIGINS=    # comma-separated; same-origin is always allowed
CHAT_RATE_IP_PER_MIN=    # default 20
CHAT_RATE_GLOBAL_PER_DAY=    # default 1000 (Groq free-tier budget)
CHAT_SMOKE_TOKEN=        # send as `message` for "pong" without a Groq call
GROQ_MODEL=              # default llama-3.3-70b-versatile
CRON_SECRET=             # bearer token for the /api/keepalive cron (anti-pause)


# ─── LEAD PIPELINE (dormant — no site form posts here since 2026-07-13) ───────
VITE_LEAD_ENDPOINT=      # Apps Script /exec URL
LEAD_SHEET_ID=


# ─── PUBLIC BUSINESS CONSTANTS ────────────────────────────────────────────────
SITE_URL=https://www.bznsflowai.com
CALENDAR_URL=
WHATSAPP_URL=
CONTACT_EMAIL=


# ─── WORKSPACE FOLDERS (absolute paths, machine-specific) ─────────────────────
VAULT_DIR=               # obsidian/business — canonical BznsFlow knowledge base
FILES_DIR=
POSTS_DIR=
WEB_DIR=
AGENT_AVATARS_DIR=
MARKETING_DIR=
CHATBOT_DIR=
