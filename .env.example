# ==============================================================================
# BznsFlow — environment template.  Copy to .env and fill in:  cp .env.example .env
# This file is COMMITTED and must never contain real values.
#
# ⚠️  VITE_* vars are BAKED INTO THE PUBLIC BROWSER BUNDLE. Never give a secret
#     the VITE_ prefix — only public URLs belong there.
# ==============================================================================


# ─── DEPLOY / HOSTING ─────────────────────────────────────────────────────────
# https://vercel.com/account/tokens — needs FULL team scope, else deploys fail
# with "Could not retrieve Project Settings". Tokens expire; note the date.
VERCEL_TOKEN=


# ─── AI / GENERATION ──────────────────────────────────────────────────────────
GEMINI_API_KEY=          # https://aistudio.google.com/apikey — agent avatar script
GROQ_API_KEY=            # https://console.groq.com — powers Layla via /api/chat


# ─── LAYLA CHAT BACKEND (Vercel /api/chat → Groq; Convex storage) ──
# Runbook: web-chatbot/SETUP.md · these are also set in Vercel (Prod + Preview).
#
# Leave VITE_CHAT_ENDPOINT UNSET — src/lib/chat.js defaults to same-origin
# '/api/chat'. Setting it is the rollback lever only.
# VITE_CHAT_ENDPOINT=


CHAT_ALLOWED_ORIGINS=    # comma-separated; same-origin is always allowed
CHAT_RATE_IP_PER_MIN=    # default 20
CHAT_RATE_GLOBAL_PER_DAY=    # default 1000 (Groq free-tier budget)
CHAT_SMOKE_TOKEN=        # send as `message` for "pong" without a Groq call
GROQ_MODEL=              # default llama-3.3-70b-versatile
CRON_SECRET=             # reserved scheduler secret; retired keepalive is disabled


# ─── LEAD PIPELINE (live — PlaybookModal and the sign-in page both post here) ─
VITE_LEAD_ENDPOINT=      # Apps Script /exec URL
LEAD_SHEET_ID=


# ─── GREEN PRODUCTION CONVEX (server-only) ────────────────────────────────────
# Provision a dedicated Green production deployment. Never copy Blue or dev
# deployment URLs here. GREEN_CONVEX_CLOUD_URL pins the expected target;
# CONVEX_CLOUD_URL is used by server routes. Keep VITE_* URLs out of production.
GREEN_CONVEX_CLOUD_URL=
CONVEX_CLOUD_URL=
CONVEX_SITE_URL=
CONVEX_SERVICE_SECRET=       # 64-hex; same value in Green Convex and Vercel
PUBLIC_SITE_ORIGIN=https://www.bznsflowai.com
BLUE_DASHBOARD_ENABLED=true
BLUE_HASIB_ENABLED=true

# ─── SIGN-IN / EMAIL OTP (Vercel /api/auth-* → Convex + Apps Script) ─────────
# Supabase auth remains available for rollback until migration is verified.

LEAD_ENDPOINT=           # server-side copy of the Apps Script /exec URL (never VITE_)
OTP_SHARED_SECRET=       # Vercel → Apps Script auth; set the SAME value in the
                         # Apps Script project's Script Properties
AUTH_OTP_PEPPER=         # hashing pepper for stored OTP codes
AUTH_RATE_IP_PER_MIN=    # default 5 — code requests per IP per minute
AUTH_RATE_GLOBAL_PER_DAY=  # default 300 — sign-in requests per day, all visitors
LEAD_RATE_IP_PER_MIN=    # default 5 — playbook submissions per IP per minute

# ─── SOCIAL SIGN-IN (Vercel /api/auth-oauth → /api/auth-callback) ─────────────
# Schema + runbook: web-chatbot/migrations/004-oauth-identities.sql
# Registry + setup notes: api/_lib/oidc.js
#
# A provider whose pair is unset simply gets no button — GET /api/auth-session
# reports which are configured and the page renders only those. So it is safe to
# ship Google alone and add the others later.
#
# The redirect URI to register with EVERY provider is exactly:
#   https://www.bznsflowai.com/api/auth-callback
# plus http://localhost:3000/api/auth-callback for `npm run dev:api`.
# Google and Microsoft accept the localhost one; LinkedIn accepts neither
# localhost nor plain http, so LinkedIn can only be tested on a real domain.
# Wildcards are not allowed anywhere, so per-deploy preview URLs cannot be used.

GOOGLE_CLIENT_ID=        # Google Cloud Console → Credentials → OAuth client ID
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=            # Entra ID → App registrations → Overview
MS_CLIENT_SECRET=        # the secret VALUE, shown once; expires in ≤24 months
MS_TENANT=               # default `organizations` — work/school accounts only.
                         # Do NOT use `common` without the xms_edov optional
                         # claim: see the nOAuth note in api/_lib/oidc.js.
LINKEDIN_CLIENT_ID=      # needs a VERIFIED LinkedIn company page first
LINKEDIN_CLIENT_SECRET=
# Microsoft sign-in remains unavailable until credentials and callbacks are tested.

# ─── CHANNEL RELEASE GATES ────────────────────────────────────────────────────
GREEN_DATA_MIGRATION_VERIFIED=false
GREEN_STATE_PATHS_CONVEX=false
GREEN_CONVEX_CUTOVER=false
GREEN_WHATSAPP_SMOKE_VERIFIED=false
GREEN_MESSAGING_WORKER_SECRET= # separate 64-hex Convex-to-Vercel worker bearer secret
GREEN_WHATSAPP_ENABLED=false
GREEN_BROADCAST_ENABLED=false # keep false until consent, limits and campaign data are migrated and reviewed
GREEN_WHATSAPP_VERIFY_TOKEN=
# Ahmed-only system-user connection; copy through the secret manager, never from a browser or source file.
GREEN_WHATSAPP_OWNER_CONNECT_ENABLED=false
GREEN_WHATSAPP_OWNER_CONNECT= # ahmed@bznsflowai.com:<WABA ID>:<phone ID>:<business ID>
GREEN_WHATSAPP_OWNER_CONNECT_TOKEN=
GREEN_INSTAGRAM_APPROVED=false
GREEN_INSTAGRAM_ENABLED=false
GREEN_INSTAGRAM_APP_ID=
GREEN_INSTAGRAM_APP_SECRET=
GREEN_INSTAGRAM_GRAPH_VERSION=

# ─── PUBLIC BUSINESS CONSTANTS ────────────────────────────────────────────────
SITE_URL=https://www.bznsflowai.com
CALENDAR_URL=
WHATSAPP_URL=
CONTACT_EMAIL=


# ─── WORKSPACE FOLDERS (absolute paths, machine-specific) ─────────────────────
VAULT_DIR=               # obsidian/business — canonical BznsFlow knowledge base
FILES_DIR=
POSTS_DIR=
WEB_DIR=
AGENT_AVATARS_DIR=
MARKETING_DIR=
CHATBOT_DIR=

# Layla official Meta Cloud API owner pilot — NEW APP ONLY; never reuse outreach credentials.
# Server-only UUID from web_accounts; registering an account does not grant pilot access.
LAYLA_OWNER_ACCOUNT_ID=
LAYLA_META_MODE=mock
LAYLA_META_KILL_SWITCH=true
LAYLA_META_APP_ID=
LAYLA_META_WABA_ID=
LAYLA_META_PHONE_NUMBER_ID=
# E.164 digits, no +. The owner pilot uses a dedicated Cloud API number.
LAYLA_META_SENDER=
LAYLA_META_APP_SECRET=
LAYLA_META_ACCESS_TOKEN=
LAYLA_META_VERIFY_TOKEN=
# Set to the supported Graph version shown by the NEW app's API Setup.
LAYLA_META_GRAPH_VERSION=
LAYLA_META_WORKER_SECRET=
# Separate owner-started inbound test; ordinary Layla remains mock + paused.
LAYLA_OPEN_TEST_ENABLED=false
# Restricted customer setup. At most two explicitly invited account UUIDs.
LAYLA_CUSTOMER_ONBOARDING_ENABLED=false
LAYLA_CUSTOMER_ACCOUNT_IDS=
LAYLA_EMBEDDED_SIGNUP_CONFIG_ID=
# Generate an independent 32-byte hex key; store only in the deployment vault.
LAYLA_CREDENTIAL_ENCRYPTION_KEY=

LAYLA_WEBSITE_IMPORT_ENABLED=

RESEND_API_KEY=

AUTH_FROM=

# Server-only owner connection (the IDs refer to Meta assets, not a phone number).
ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_BUSINESS_NUMBER_ID=
