# BznsFlow Web Chat — secrets reference (NAMES only, no real values).
#
# NOTE (n8n 2.63): the workflow does NOT read $env in Code nodes — n8n 2.x
# blocks that by default (N8N_BLOCK_ENV_ACCESS_IN_NODE=true). Secrets live in
# n8n CREDENTIALS instead. You attach two credentials after importing the workflow:
#
#   1) "Supabase Web Chat (Postgres)"  — Postgres credential
#      Host / Database / User / Password / Port / SSL from your NEW Supabase
#      project → Project Settings → Database → Connect → Session pooler.
#      SSL = require + "Ignore SSL Issues" ON (self-signed pooler chain).
#      Used by the 3 Postgres nodes.
#
#   2) "Groq account" — Groq API credential (type: Groq API)
#      Value: <your Groq API key, gsk_...>  from https://console.groq.com
#      Used by the "Groq Chat Model" sub-node (model: llama-3.3-70b-versatile).
#
# NEVER commit a real .env. (.gitignore in this folder blocks it.)

# ---- Groq (goes into the Groq API credential, not env) ----
GROQ_API_KEY=

# ---- Supabase Postgres connection (goes into the Postgres credential, not env) ----
# Prefer the Session Pooler host (Railway can't reach the IPv6-only direct host).
SUPABASE_DB_HOST=          # e.g. aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=          # e.g. postgres.<project-ref>
SUPABASE_DB_PASSWORD=
SUPABASE_DB_PORT=5432
# SSL: require  (+ "Ignore SSL Issues" ON in the n8n credential)

# ---- n8n / Railway service settings (set on the Railway service, not in the workflow) ----
# N8N_ENCRYPTION_KEY=            # auto-set by the Railway n8n template
# GENERIC_TIMEZONE=Asia/Muscat
# WEBHOOK_URL=                   # your public n8n URL, so webhook Production URLs resolve
