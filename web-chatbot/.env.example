# Layla web chat — variable NAMES only, never real values.
#
# These are set in Vercel (Settings → Environment Variables) for Production AND
# Preview, and read server-side by api/chat.js. For local work they live in the
# repo-root .env, which is where every BznsFlow secret is kept — this file is a
# reference for what /api/chat needs, not a second place to store things.
#
# ⚠️ No variable here may take a VITE_ prefix. Vite inlines VITE_* into the
#    public browser bundle, so a prefixed secret ships to every visitor.

# ---- OpenAI (the LLM) ----
OPENAI_API_KEY=          # https://platform.openai.com
OPENAI_MODEL=            # optional; defaults to gpt-4.1-mini

# ---- Supabase ----
# PostgREST over HTTPS — the function never opens a Postgres socket, so no
# pooler host, no direct DB URL, and no connection string is needed anywhere.
SUPABASE_URL=            # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # bypasses RLS — server-side only, forever

# ---- Policy ----
# Same-origin callers are always allowed, so this is only for genuine
# cross-origin callers (e.g. the apex domain when the site serves from www).
CHAT_ALLOWED_ORIGINS=    # comma-separated absolute origins
CHAT_RATE_IP_PER_MIN=    # default 20
CHAT_RATE_GLOBAL_PER_DAY=    # default 1000 — a daily SPEND ceiling; OpenAI
                             # bills per token, so this is the only thing
                             # standing between a bot and the bill
CHAT_SMOKE_TOKEN=        # send as `message` to get "pong" without an LLM call
CRON_SECRET=             # bearer token Vercel sends to /api/keepalive (cron)

# ---- Client ----
# Leave UNSET. src/lib/chat.js defaults to same-origin '/api/chat'; setting this
# is the rollback lever only. It previously held the Railway webhook, which was
# deleted — restoring that value re-breaks the chat.
# VITE_CHAT_ENDPOINT=
