{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/keepalive.js": {
      "maxDuration": 10
    },
    "api/auth-code.js": {
      "maxDuration": 30
    },
    "api/auth-session.js": {
      "maxDuration": 30
    },
    "api/auth-oauth.js": {
      "maxDuration": 10
    },
    "api/auth-callback.js": {
      "maxDuration": 30
    },
    "api/lead.js": {
      "maxDuration": 30
    },
    "api/layla-meta.js": {
      "maxDuration": 60
    },
    "api/layla-meta-webhook.js": {
      "maxDuration": 30
    },
    "api/layla-meta-worker.js": {
      "maxDuration": 60
    },
    "api/layla-meta-readiness.js": {
      "maxDuration": 30
    }
  },
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/api/layla-meta-activation",
      "destination": "/api/layla-meta?surface=activation"
    },
    {
      "source": "/api/layla-meta-test",
      "destination": "/api/layla-meta?surface=test"
    },
    {
      "source": "/api/product-setup",
      "destination": "/api/layla-meta?surface=product-setup"
    },
    {
      "source": "/api/knowledge",
      "destination": "/api/layla-meta?surface=knowledge"
    }
  ],
  "redirects": [
    {
      "source": "/layla/setup",
      "destination": "/catalyst/setup",
      "permanent": false
    },
    {
      "source": "/en/layla/setup",
      "destination": "/en/catalyst/setup",
      "permanent": false
    },
    {
      "source": "/ascend/setup",
      "destination": "/layla/dashboard",
      "permanent": false
    },
    {
      "source": "/en/ascend/setup",
      "destination": "/en/layla/dashboard",
      "permanent": false
    },
    {
      "source": "/ar",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ar/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.facebook.com https://connect.facebook.net; connect-src 'self' https://connect.facebook.net; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
